        "items": {
            "thiet-ke-cang": {
                "title": "Port Equipment Installation & Design",
                "desc": "Specializing in designing, constructing, and renovating equipment systems at seaports and inland ports such as cranes and container transport systems.",
                "fullContent": "We understand that in the seaport industry, every minute of downtime causes great economic damage.\nTherefore, Maintech's solutions always focus on two factors: Maximum efficiency and Absolute reliability.\n\nWith a team of engineers deeply trained in STS gantry cranes and RTG tire cranes, we confidently take on the most complex projects from technical drawing design to on-site installation.",
                "features": [
                    "Design & construction of gantry crane (STS), tire crane (RTG) systems",
                    "Unexpected & periodic maintenance to optimize operations",
                    "Control system upgrade for old generation equipment",
                    "Inspection and load testing according to international maritime safety standards"
                ]
            },
            "thiet-ke-f-b": {
                "title": "F&B Industry Equipment Design & Installation",
                "desc": "Solutions for microbiological production lines, tanks, and automated packaging systems for the food and beverage industry.",
                "fullContent": "Hygiene and safety are the top priorities in the F&B industry. Maintech provides microbiological stainless steel piping systems, ASME standard tanks, and automated solutions to minimize human intervention in the production process.\n\nWe advise and deploy modern CIP (Clean-In-Place) systems, saving water and chemicals while ensuring maximum sterility for the system.",
                "features": [
                    "Installation of high standard microbiological stainless steel piping systems",
                    "Installation of automatic processing and packaging equipment",
                    "Optimizing factory space and operating processes",
                    "Digitizing the quality management & reporting process"
                ]
            },
            "thiet-ke-nang-ha": {
                "title": "Lifting Equipment Design & Installation",
                "desc": "Design, manufacture, and installation of industrial lifting systems for factories, warehouses, and construction sites.",
                "fullContent": "Maintech provides tailor-made overhead cranes, gantry cranes, and freight elevators suitable for the structure and purpose of each factory.\n\nEvery equipment is integrated with a multi-layer safety system, including load sensors, travel limits, and the most modern emergency braking system.",
                "features": [
                    "Design of cranes, freight elevators, and conveyors",
                    "Installation according to strict technical standards",
                    "Providing genuine spare parts and fast support",
                    "Safety inspection and periodic operating license"
                ]
            },
            "bao-tri-cang": {
                "title": "Port Industry Equipment Maintenance & Repair",
                "desc": "Professional maintenance services for your port crane system, ensuring continuous 24/7 operation.",
                "fullContent": "Our maintenance service includes periodic inspections of mechanical, electrical, and hydraulic systems of STS and RTG cranes. We commit to a fast response time to minimize downtime at the port.",
                "features": [
                    "Periodic inspection of electromechanical systems",
                    "24/7 emergency repair on-site",
                    "Cable replacement and brake system inspection",
                    "Upgrading to modern technology solutions"
                ]
            },
            "bao-tri-f-b": {
                "title": "F&B Industry Equipment Maintenance & Repair",
                "desc": "Maintenance service for food production lines, meeting strict hygiene standards.",
                "fullContent": "Ensure your production line is always in top condition with periodic maintenance. We provide flexible solution packages suitable for the factory's production schedule.",
                "features": [
                    "Maintenance of tanks and stainless steel pipes",
                    "Industrial cleaning and disinfection of systems",
                    "Replacement of genuine automation equipment",
                    "Software upgrades adjusting the process"
                ]
            },
            "bao-tri-nang-ha": {
                "title": "Lifting Equipment Maintenance & Repair",
                "desc": "Comprehensive maintenance solutions for industrial lifting systems.",
                "fullContent": "Lifting systems need regular inspection to ensure occupational safety. Maintech provides a package from inspection to repairing and replacing components.",
                "features": [
                    "Safety checks and regular load tests",
                    "Repairing bridge girders and brake systems",
                    "Fast supply of replacement materials & parts",
                    "Modernizing crane control systems"
                ]
            },
            "cung-cap-xay-dung": {
                "title": "Construction Equipment Supply",
                "desc": "Distributing high-quality construction machinery and materials.",
                "fullContent": "We provide all kinds of machinery and equipment for construction from the world's leading brands, ensuring performance and durability in harsh environments.",
                "features": [
                    "Imported construction machinery",
                    "100% genuine replacement parts",
                    "Rental of construction lifting equipment",
                    "Consulting on construction equipment solutions"
